# ==============================================================================
# CampusGrid AI: Environment Configuration Blueprint (.env.example)
# Copy this file to '.env' inside backend/ or project root.
# ==============================================================================

DATABASE_URL=postgresql://campusgrid_user:campusgrid_secure_password@localhost:5432/campusgrid_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Pluggable LLM Switch: 'gemini', 'openai', 'anthropic', 'groq', 'ollama'
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Weather API & Coordinates
WEATHER_PROVIDER=open-meteo
OPENWEATHER_API_KEY=optional_openweather_key_here
CAMPUS_LATITUDE=6.9147
CAMPUS_LONGITUDE=79.9733

# Security & JWT
JWT_SECRET_KEY=campusgrid_super_secret_jwt_key_replace_in_production_32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# RAG & Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_TOP_K=2

# Physical Boundaries
COMFORT_MIN_TEMP_C=21.0
COMFORT_MAX_TEMP_C=25.5
BATTERY_MIN_SOC=0.20
BATTERY_MAX_SOC=0.90
BATTERY_CAPACITY_KWH=500.0
BATTERY_MAX_POWER_KW=100.0

# Network
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
