# ==============================================================================
# CampusGrid AI: Modular Multi-Agent Environment Blueprint (.env.example)
# Copy this file to '.env' and customize provider switches and credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME="CampusGrid AI"
APP_VERSION=4.2.0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Public pilot inquiry email (optional in development; required for live delivery).
# For Gmail, use smtp.gmail.com:587 and an App Password from the sending mailbox.
# Keep PILOT_SMTP_PASSWORD in your deployment secrets; never commit it or expose it to Vite.
PILOT_SMTP_HOST=smtp.gmail.com
PILOT_SMTP_PORT=587
PILOT_SMTP_USERNAME=
PILOT_SMTP_PASSWORD=
PILOT_SMTP_STARTTLS=true
PILOT_EMAIL_FROM=
PILOT_EMAIL_RECIPIENT=amasha.weerasuriya003@gmail.com
PILOT_EMAIL_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# 2. PLUGGABLE LLM PROVIDER SWITCH (Zero-Code Switch)
# ------------------------------------------------------------------------------
# Supported Providers: 'mock', 'litellm', 'openai', 'gemini', 'anthropic', 'groq', 'ollama'
# Set 'mock' for instant deterministic offline execution without API keys!
# A vendor name must agree with LLM_MODEL's prefix (LLM_PROVIDER=gemini -> LLM_MODEL=gemini/...);
# a mismatch stops startup. 'litellm' routes by LLM_MODEL alone. Requires Python 3.11+.
LLM_PROVIDER=mock
LLM_MODEL=gemini/gemini-3.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=30
LLM_NUM_RETRIES=2

# Provider API Keys (Fill in key for your active cloud provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 3. EMBEDDING PROVIDER SWITCH
# ------------------------------------------------------------------------------
# Supported Providers: 'mock' (instant, zero download), 'sentence_transformers'
#
# WARNING: 'mock' generates md5-hash pseudo-vectors. They are deterministic and fast,
# which is what CI wants, but they carry NO semantic meaning — dense retrieval scores
# are effectively random and only BM25 keeps hybrid search working. Switch to
# 'sentence_transformers' (requires: pip install -e ".[rag]") before any retrieval
# demo, RAG evaluation, or IR metrics run. If the package is missing, the app falls back
# to 'mock', switches the dense leg OFF (keyword search only) and /api/health says so.
#
# EMBEDDING_DIMENSION must match the pgvector column in backend/data/init.sql.
# Changing the model to a 768- or 1536-dim one requires altering that column
# and re-indexing the corpus.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------------------
# 4. VECTOR DATABASE SWITCH
# ------------------------------------------------------------------------------
# Supported Providers: 'memory' (in-memory cosine similarity), 'pgvector', 'chroma'
# 'pgvector' needs DATABASE_PROVIDER=postgres; an unsupported combination stops startup.
VECTOR_STORE_PROVIDER=memory
RAG_TOP_K=2

# ------------------------------------------------------------------------------
# 5. RELATIONAL DATABASE SWITCH
# ------------------------------------------------------------------------------
# Supported Providers: 'in_memory' (seeded with 48 intervals), 'postgres' (Neon Serverless)
DATABASE_PROVIDER=in_memory
DATABASE_URL=postgresql://campusgrid_user:campusgrid_secure_password@localhost:5432/campusgrid_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 6. CACHE PROVIDER SWITCH
# ------------------------------------------------------------------------------
# Supported Providers: 'memory' ('redis' is not implemented and stops startup)
CACHE_PROVIDER=memory

# ------------------------------------------------------------------------------
# 7. RERANKER STRATEGY
# ------------------------------------------------------------------------------
# Supported Strategies: 'rrf' (Reciprocal Rank Fusion), 'passthrough' (ablation baseline).
# 'cross_encoder' was evaluated and deferred; selecting it stops startup with a clear error.
RERANKER_STRATEGY=rrf

# ------------------------------------------------------------------------------
# 8. WEATHER SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
WEATHER_PROVIDER=open-meteo
OPENWEATHER_API_KEY=
CAMPUS_LATITUDE=6.9147
CAMPUS_LONGITUDE=79.9733

# ------------------------------------------------------------------------------
# 9. ACCESS & SECURITY LAYER (JWT & Authentication)
# ------------------------------------------------------------------------------
# Every endpoint except /api/health and /api/auth/login needs 'Authorization: Bearer <token>'.
# This example value is public. APP_ENV=production refuses to start with it (or with any key shorter
# than 32 characters); in development it is replaced by a random per-process key, so sessions end on
# every restart until you set your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=campusgrid_super_secret_jwt_key_replace_in_production_32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_REQUEST_BODY_BYTES=1048576
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
# HMAC key for the audit hash chain. Without it the chain is a plain SHA-256 that anyone with
# database write access can recompute after editing a row. Required (32+ chars) in production.
# Keep it somewhere the database role cannot read. Generate like the JWT key above.
AUDIT_SIGNING_KEY=
# When you add AUDIT_SIGNING_KEY to a database that already has audit rows, set this ONCE to the
# row count at that moment (SELECT count(*) FROM audit_log_store). 0 for a new database.
AUDIT_LEGACY_UNKEYED_ROWS=0
# Four-eyes rule: the manager who requested a plan cannot approve it. Off for the one-manager demo.
REQUIRE_SEPARATE_APPROVER=false
# Per-user budget on the LLM/solver endpoints (query, dispatch, what-if, forecast, RAG, MCP). 0 = off.
PLANNER_RATE_LIMIT_PER_MINUTE=30

# ------------------------------------------------------------------------------
# 10. DETERMINISTIC PHYSICAL SAFETY LIMITS (Hard Physical Guardrails)
# ------------------------------------------------------------------------------
COMFORT_MIN_TEMP_C=21.0
COMFORT_MAX_TEMP_C=25.5
BATTERY_MIN_SOC=0.20
BATTERY_MAX_SOC=0.90
BATTERY_CAPACITY_KWH=500.0
BATTERY_MAX_POWER_KW=100.0

# 2R2C building thermal model (SRS section 6.1). C_IN and R_VENT are the calibrated pair
# (src/agents/digital_twin/thermal_calibration.py); the wall constants are uncalibrated defaults.
BUILDING_C_IN=50.0
BUILDING_R_VENT=2.5
BUILDING_C_WALL=200.0
BUILDING_R_IN=2.0
BUILDING_R_OUT=6.0
# Cooling one zone can draw when Agent 2 holds a requested setpoint (kW thermal)
HVAC_MAX_COOLING_KW=35.0

# ------------------------------------------------------------------------------
# 11. TEAM DEVELOPMENT SWITCH
# ------------------------------------------------------------------------------
# When true, the DI container wires the reference baseline implementations for
# Agents 1, 2 and 4 instead of the member scaffolds. This lets the full pipeline
# run end-to-end while members are still implementing their algorithms — so
# nobody is blocked waiting on anybody else.
#
# Set true if: you are integrating, demoing, or working on a slice that consumes
#              another member's not-yet-finished output.
# Set false if: you are testing your OWN implementation.
USE_REFERENCE_BASELINES=false

# Finer-grained alternative: list only the UNFINISHED slices (any of agent1, agent2, agent4).
# The others keep running member code. Ignored when USE_REFERENCE_BASELINES=true.
# All three member slices are implemented, so none is on its baseline by default.
# /api/health -> agent_slices shows what is actually running.
REFERENCE_BASELINE_AGENTS=
