# ==============================================================================
# CampusGrid AI: Environment Configuration Blueprint (.env.example)
# Copy this file to '.env' and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Paste your Neon PostgreSQL connection string below.
# Neon supports pgvector natively. Ensure '?sslmode=require' is appended.
# Example: postgresql://neondb_owner:npg_xyz123@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://campusgrid_user:campusgrid_secure_password@localhost:5432/campusgrid_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 2. PLUGGABLE LLM PROVIDER CONFIGURATION (Zero-Code Switch)
# ------------------------------------------------------------------------------
# Change LLM provider and model without ANY code changes:
# Supported Providers: 'gemini', 'openai', 'anthropic', 'groq', 'ollama'
LLM_PROVIDER=gemini

# Recommended Models:
# - Gemini:    'gemini/gemini-1.5-flash' or 'gemini/gemini-1.5-pro'
# - OpenAI:    'openai/gpt-4o-mini' or 'openai/gpt-4o'
# - Anthropic: 'anthropic/claude-3-5-sonnet-20240620'
# - Groq:      'groq/llama-3.1-70b-versatile'
# - Ollama:    'ollama/llama3' (local, no API key needed)
LLM_MODEL=gemini/gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500

# ------------------------------------------------------------------------------
# 3. API KEYS (Fill in the key for your active provider)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Get at: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (Get at: https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq Cloud API Key (Get at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 4. WEATHER SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# Weather provider: 'open-meteo' (free, no API key required) or 'openweathermap'
WEATHER_PROVIDER=open-meteo
OPENWEATHER_API_KEY=optional_openweather_key_here

# Campus Coordinates (Defaults to SLIIT Malabe Campus, Sri Lanka)
CAMPUS_LATITUDE=6.9147
CAMPUS_LONGITUDE=79.9733

# ------------------------------------------------------------------------------
# 5. ACCESS & SECURITY LAYER (Authentication & Tokens)
# ------------------------------------------------------------------------------
# Generate a secure 32-byte secret: `openssl rand -hex 32`
JWT_SECRET_KEY=campusgrid_super_secret_jwt_key_replace_in_production_32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 6. INFORMATION RETRIEVAL (RAG) & EMBEDDING MODEL
# ------------------------------------------------------------------------------
# Default sentence-transformers model (384 dimensions, runs locally on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_TOP_K=2

# ------------------------------------------------------------------------------
# 7. DETERMINISTIC PHYSICAL SAFETY LIMITS (Hard Guardrails)
# ------------------------------------------------------------------------------
COMFORT_MIN_TEMP_C=21.0
COMFORT_MAX_TEMP_C=25.5
BATTERY_MIN_SOC=0.20
BATTERY_MAX_SOC=0.90
BATTERY_CAPACITY_KWH=500.0
BATTERY_MAX_POWER_KW=100.0

# ------------------------------------------------------------------------------
# 8. SERVER & CLIENT NETWORKING
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
